  ],
  "presets": [
    {
      "name": "V-Auto Tabs Section",
      "category": "Custom Sections (valmax)",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
