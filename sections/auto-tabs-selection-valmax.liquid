<div class="auto-tabs-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}" data-autoplay-speed="5000">

  <div class="auto-tabs-header">
    <h1 class="auto-tabs-section-title">{{ section.settings.heading | escape }}</h1>
  </div>

  <div class="tab-backgrounds">
    {%- for block in section.blocks -%}
      <div class="tab-bg-image {% if forloop.first %}active{% endif %}"
           data-tab-index="{{ forloop.index0 }}"
           style="background-image: url('{{ block.settings.bg_image | img_url: '2000x' }}');">
      </div>
    {%- endfor -%}
  </div>

  <div class="auto-tabs-container page-width">
    <div class="auto-tabs__nav" role="tablist">
      {%- for block in section.blocks -%}
        <button class="auto-tabs__button {% if forloop.first %}active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="tab-panel-{{ section.id }}-{{ forloop.index }}"
                id="tab-button-{{ section.id }}-{{ forloop.index }}"
                data-tab-index="{{ forloop.index0 }}">
          {{ block.settings.tab_title | escape }}
        </button>
      {%- endfor -%}
    </div>


    <div class="auto-tabs__content">
      {%- for block in section.blocks -%}
        <div class="auto-tabs__panel {% if forloop.first %}active{% endif %}"
             role="tabpanel"
             id="tab-panel-{{ section.id }}-{{ forloop.index }}"
             aria-labelledby="tab-button-{{ section.id }}-{{ forloop.index }}"
             {% unless forloop.first %}hidden{% endunless %}>

          <div class="tab-panel-inner">
            {% if block.settings.tab_image != blank %}
              <div class="tab-panel__image">
                <img src="{{ block.settings.tab_image | img_url: '600x' }}" alt="{{ block.settings.tab_image.alt | escape }}">
              </div>
            {% else %}
              <div class="tab-panel__image">
                QQQ
              </div>
            {% endif %}
            <div class="tab-panel__text">
              <p>{{ block.settings.tab_heading | escape }}</p>
              <div class="rte">{{ block.settings.tab_text }}</div>
              {% if block.settings.tab_button_label != blank and block.settings.tab_button_link != blank %}
                <a href="{{ block.settings.tab_button_link }}" class="button-custom">
                  {{ block.settings.tab_button_label | escape }} {% render 'icon-arrow' %}
                </a>
              {% endif %}
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>


{% style %}
  .slider__valmax{
    background-color: {{ section.settings.color_background_section }};
  }

  .slider__valmax-wrapper-slide{
    background-color: {{ section.settings.color_background_card }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<style>

  .auto-tabs-section-title{
    font-weight: 500;
    font-size: 50px;
    line-height: 120%;
    letter-spacing: -2%;
    text-align: center;
    text-transform: capitalize;
  }

  .auto-tabs__panel {
    padding: 40px;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .auto-tabs__panel.active {
    opacity: 1;
    position: relative;
  }

  .auto-tabs__panel[hidden] {
    display: none;
  }

  .auto-tabs__content {
    position: relative;
    min-height: 300px;
  }


  .auto-tabs-section {
    position: relative; /* Важно! */
    min-height: 600px; /* Минимальная высота секции */
  }

  .auto-tabs-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .auto-tabs-container {
    border-radius: 8px;
    overflow: hidden;
    position: relative; /* Важно! */
    z-index: 2; /* Контент над фоном */
    padding-top: 60px;
  }

  .auto-tabs__nav {
    display: flex;
    border: 1px solid #e1e1e1;
    color: #FAF7F1;
    border-radius: 30px;
    backdrop-filter: blur(10px); /* Размытие фона behind элемента */
    -webkit-backdrop-filter: blur(10px); /* Для Safari */
  }

  .auto-tabs__button {
    flex: 1;
    padding: 6px 20px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    border-radius: 30px;
    text-transform: uppercase;
    color: #e1e1e1;
  }

  .auto-tabs__button:hover {
    background: rgba(250, 247, 241, 0.15);
    border-radius: 30px;
  }

  .auto-tabs__button.active {
    background-color: #ffffff;
    color: #251E1B;
    font-weight: bold;
  }

  .tab-panel-inner {
    display: flex;
    align-items: baseline;
    gap: 40px;
    flex-direction: column;
    width: 453px;
    padding: 20px;
    border: 1px solid #FCF6EC1A;
    color: #FAF7F1;
    backdrop-filter: blur(10px); /* Размытие фона behind элемента */
    -webkit-backdrop-filter: blur(10px); /* Для Safari */
  }

  .tab-panel__image {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid #FCF6EC1A;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .tab-panel-inner .rte {
    margin-bottom: 30px;
  }

  .tab-panel__image img {
    width: 26px;
    height: 26px;
    border-radius: 4px;
  }

  .tab-panel__image svg {
    width: 26px;
    height: 26px;
  }

  .tab-panel__text {
    flex: 1;
  }

  .tab-panel__text h3 {
    margin-top: 0;
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {

    .tab-panel__image {
      flex: 0 0 auto;
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
    }

    .auto-tabs__nav {
      flex-direction: column;
    }
  }

  .tab-backgrounds {
    position: absolute;
    /*top: 0;*/
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .tab-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .tab-bg-image.active {
    opacity: 1;
  }

  .auto-tabs__button p {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid #FAF7F1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {

    const autoplayIntervals = {};

    initAllAutoTabs();

    function initAllAutoTabs() {
      const sections = document.querySelectorAll('.auto-tabs-section');

      sections.forEach(section => {
        initAutoTabsSection(section);
      });
    }

    function initAutoTabsSection(section) {
      const sectionId = section.dataset.sectionId;
      const tabsContainer = section.querySelector('.auto-tabs-container');
      const tabButtons = section.querySelectorAll('.auto-tabs__button');
      const tabPanels = section.querySelectorAll('.auto-tabs__panel');
      const autoplaySpeed = parseInt(tabsContainer.dataset.autoplaySpeed) || 5000;

      let currentTabIndex = 0;
      let isPaused = false;

      function stopAutoplay() {
        if (autoplayIntervals[sectionId]) {
          clearInterval(autoplayIntervals[sectionId]);
          autoplayIntervals[sectionId] = null;
        }
      }

      function startAutoplay() {
        stopAutoplay();

        autoplayIntervals[sectionId] = setInterval(function() {
          if (!isPaused) {
            nextTab();
          }
        }, autoplaySpeed);
      }

      function switchToTab(newIndex) {

        if (newIndex === currentTabIndex) return;


        tabPanels.forEach(function(panel) {
          panel.classList.remove('active');
          panel.setAttribute('hidden', '');
        });

        tabButtons.forEach(function(button) {
          button.classList.remove('active');
          button.setAttribute('aria-selected', 'false');
        });

        tabPanels[newIndex].classList.add('active');
        tabPanels[newIndex].removeAttribute('hidden');

        tabButtons[newIndex].classList.add('active');
        tabButtons[newIndex].setAttribute('aria-selected', 'true');

        const bgImages = section.querySelectorAll('.tab-bg-image');
        bgImages.forEach(function(bg) {
          bg.classList.remove('active');
        });

        const activeBg = section.querySelector(`.tab-bg-image[data-tab-index="${newIndex}"]`);
        if (activeBg) {
          activeBg.classList.add('active');
        }

        currentTabIndex = newIndex;
      }

      function nextTab() {
        const nextIndex = (currentTabIndex + 1) % tabButtons.length;
        switchToTab(nextIndex);
      }

      function pauseAutoplay() {
        isPaused = true;
      }

      function resumeAutoplay() {
        isPaused = false;
      }

      tabButtons.forEach(function(button, index) {
        button.addEventListener('click', function() {
          switchToTab(index);
          stopAutoplay();
          startAutoplay();
        });
      });

      tabsContainer.addEventListener('mouseenter', pauseAutoplay);
      tabsContainer.addEventListener('mouseleave', resumeAutoplay);

      startAutoplay();
    }
  });
</script>

{% schema %}
{
  "name": "Auto-switching Tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Intelligent Solutions for Everyday Harmony",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "default": "Tab Title",
          "label": "Tab Title"
        },
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Tab Image"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "BG Image"
        },
        {
          "type": "text",
          "id": "tab_heading",
          "default": "Feature Heading",
          "label": "Tab Content Heading"
        },
        {
          "type": "richtext",
          "id": "tab_text",
          "default": "<p>Describe the feature or service here.</p>",
          "label": "Tab Content Text"
        },
        {
          "type": "text",
          "id": "tab_button_label",
          "default": "Learn More",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "tab_button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Auto-switching Tabs",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
