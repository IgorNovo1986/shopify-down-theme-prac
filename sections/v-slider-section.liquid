
<div style="background-color: {{ section.settings.color_background_card }};">

  <div class="slider__section page-width">

      <div class="slider__section-content">
        <p class="description">{{ section.settings.heading }}</p>
        <h1 class="title">{{ section.settings.sub_heading }}</h1>
      </div>

      <div class="slider__section-wrapper-slide">
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}

            <div class="slider__section-slide">

              <div class="slider__section-slide-content">
                <span>{{ forloop.index }} of {{ forloop.length }} / {{ block.settings.heading }}</span>

                <div>
                  <h2 class="title">{{ block.settings.heading }}</h2>
                  <p class="description">{{ block.settings.sub_heading }}</p>
                </div>
              </div>

              <div class="slider__section-slide-img">
                <div class="slider__section-slide-wrapper-img">
                  {% if block.settings.image != blank %}
                    {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                    loading: 'lazy',
                    class: 'slider__section-img'
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              </div>

            </div>

          {% endif %}
        {% endfor %}
      </div>

      <div class="slider__section-slide-btn">
        <button class="prev"> {% render 'icon-arrow' %} </button>
        <button class="next"> {% render 'icon-arrow' %} </button>
      </div>

    </div>
</div>

<style>

  .slider__section{
    color: #FAF7F1;
    position: relative;
    width: 100%;
    overflow: hidden;
    margin: 0 auto;

    padding-top: 76px;
    padding-bottom: 108px;
  }

  .slider__section-content {
    max-width: 475px;
  }

  .slider__section-content .description {
    font-weight: 400;
    font-style: Normal;
    font-size: 25px;
    line-height: 120%;
    letter-spacing: -2%;
    color: #FAF7F1;

    margin-top: 35px;
  }

  .slider__section-content .title{
    font-weight: 500;
    font-size: 50px;
    line-height: 120%;
    letter-spacing: -2%;
    color: #FAF7F1;
    margin-top: 25px;
    margin-bottom: 55px;
  }

  @media screen and (max-width: 992px) {
    .slider__section {
      padding-top: 20px;
      padding-bottom: 80px;
    }

    .slider__section-content .description {
      font-size: 18px;
    }

    .slider__section-content .title{
      font-size: 34px;
      margin-top: 0px;
      margin-bottom: 35px;
    }
  }

  .slider__section-wrapper-slide {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 28px;
    display: flex;
    transition: transform 0.3s ease-in-out;
    border: 1px solid #FCF6EC1A;
  }

  .slider__section-slide {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 40px;
  }

  .slider__section-slide-content span {
    font-weight: 400;
    font-size: 16px;
    line-height: 106%;
  }

  .slider__section-slide-content div h2 {
    font-weight: 500;
    font-size: 32px;
    line-height: 120%;
    color: #FAF7F1;
  }

  .slider__section-slide-content div p {
    font-weight: 400;
    font-style: Normal;
    font-size: 18px;
    line-height: 140%;
    margin: -10px 0;
    color: #FAF7F1;
  }

  @media screen and (max-width: 992px) {
    .slider__section-slide{
      flex-direction: column;
    }

    .slider__section-wrapper-slide {
      padding-bottom: 80px !important;
    }

    .slider__section-slide-content span {
      font-size: 14px;
    }

    .slider__section-slide-content div h2 {
      font-size: 20px;
      line-height: 124%;
    }

    .slider__section-slide-content div p {
      font-size: 16px;
    }
  }

  .slider__section-wrapper-slide {
    padding: 15px 30px;
  }

  .slider__section-slide-content div {
    max-width: 435px;
  }

  .slider__section-slide-content,
  .slider__section-slide-img {
    width: 50%;
  }

  .slider__section-slide-wrapper-img{
    height: 476px;
  }

  .slider__section-slide-wrapper-img svg{
    height: 476px;
    width: 100%;
  }

  @media screen and (max-width: 992px) {
    .slider__section-slide-content,
    .slider__section-slide-img {
      width: 100%;
    }

    .slider__section-slide-wrapper-img{
      height: 253px;
    }

    .slider__section-slide-wrapper-img svg{
      height: 253px;
    }

    .slider__section-slide-btn {
      position: absolute;
      bottom: 100px !important;
      left: 40px !important;
    }

    .slider__section-slide-btn button{
      width: 32px !important;
      height: 32px !important;
    }
  }

  .slider__section-img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slider__section-slide-img svg,
  .slider__section-slide-btn button svg {
    stroke: #FAF7F1;
  }

  .slider__section-slide-img svg {
    border: 1px solid #FAF7F1;
  }

  .slider__section-slide-btn {
    position: absolute;
    bottom: 135px;
    left: 70px;
  }

  .slider__section-slide-btn button{
    border-radius: 50%;
    width: 44px;
    height: 44px;
    background-color: transparent;
    border: 1px solid #FAF7F1;
    cursor: pointer;
  }

  .slider__section-slide-btn .prev svg{
    rotate: 180deg;
  }

</style>

{% style %}
  .slider__section-wrapper-slide{
    background-color: {{ section.settings.color_background_section }};
  }
{% endstyle %}


<script>
  function initSliderValmax() {
    const slider = document.querySelector('.slider__section-wrapper-slide');
    const slides = document.querySelectorAll('.slider__section-slide');
    const prevBtn = document.querySelector('.slider__section-slide-btn .prev');
    const nextBtn = document.querySelector('.slider__section-slide-btn .next');

    let currentIndex = 0;
    let isAnimating = false;
    let touchStartX = 0;
    let touchEndX = 0;


    function addSliderStyles() {
      if (!slider) return;

      slider.style.display = 'flex';
      slider.style.transition = 'transform 0.3s ease-in-out';
      slider.style.width = '100%';


      slides.forEach((slide, index) => {
        slide.style.flex = '0 0 100%';
        slide.style.width = '100%';
        slide.style.minWidth = '100%';


        if (index !== currentIndex) {
          slide.style.opacity = '0';
          slide.style.visibility = 'hidden';
          slide.style.position = 'absolute';
        } else {
          slide.style.opacity = '1';
          slide.style.visibility = 'visible';
          slide.style.position = 'relative';
        }
      });
    }

    function updateSliderPosition() {
      if (!slider || !slides.length) return;

      slides.forEach((slide, index) => {
        if (index === currentIndex) {
          slide.style.opacity = '1';
          slide.style.visibility = 'visible';
          slide.style.position = 'relative';
          slide.style.transition = 'opacity 0.3s ease-in-out';
        } else {
          slide.style.opacity = '0';
          slide.style.visibility = 'hidden';
          slide.style.position = 'absolute';
        }
      });

      // slider.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    function goToSlide(index) {
      if (isAnimating || index < 0 || index >= slides.length) return;

      isAnimating = true;

      slides[currentIndex].style.opacity = '0';

      setTimeout(() => {
        currentIndex = index;
        updateSliderPosition();

        setTimeout(() => {
          isAnimating = false;
        }, 300);
      }, 150);
    }

    function nextSlide() {
      if (currentIndex < slides.length - 1) {
        goToSlide(currentIndex + 1);
      }
    }

    function prevSlide() {
      if (currentIndex > 0) {
        goToSlide(currentIndex - 1);
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', prevSlide);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', nextSlide);
    }

    if (slider) {
      slider.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      });

      slider.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      });
    }

    function handleSwipe() {
      if (isAnimating) return;

      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
    }

    addSliderStyles();
    updateSliderPosition();
  }

  document.addEventListener('DOMContentLoaded', initSliderValmax);
</script>


{% schema %}
{
  "name": "V-Slider Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Human Need"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub heading",
      "default": "Harmony of Body, Mind, and Space — All in One Solution"
    },
    {
      "type": "color_background",
      "id": "color_background_section",
      "label": "Background",
      "default": "#312A27"
    },
    {
      "type": "color_background",
      "id": "color_background_card",
      "label": "Background card",
      "default": "#251E1B"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Overwhelmed by Stress?",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label"
        },
        {
          "type": "inline_richtext",
          "id": "sub_heading",
          "default": "The relentless pace of modern life can leave us depleted, longing for moments of profound peace and mental clarity.",
          "label": "t:sections.slideshow.blocks.slide.settings.subheading.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V-Slider Section",
      "category": "Custom Sections (valmax)",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}