
<div class="v-scroll-gallery-section    page-width section-{{ section.id }}-padding">

    <div class="v-scroll-gallery-text-content">
      <h1 class="v-scroll-gallery-text-content__title">{{ section.settings.title }}</h1>
      <p class="v-scroll-gallery-text-content__description">{{ section.settings.sub_title }}</p>
    </div>

    <div class="v-scroll-gallery-container">

      <div class="v-scroll-gallery">
        {% for block in section.blocks %}
          <div class="v-scroll-gallery--item v-scroll-gallery--item-{{ forloop.index }}">
            {% if block.settings.image != blank %}
              {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
              loading: 'lazy',
              class: 'v-scroll-gallery--image'
              }}
            {% else %}
              <div class="v-scroll-gallery-placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

    </div>
  </div>

<style>

  .v-scroll-gallery-section{
    height: 800px;
  }

  .v-scroll-gallery-text-content{
    margin: 0 auto;
    max-width: 500px;
  }

  .v-scroll-gallery-text-content__title {
    font-weight: 500;
    font-size: 50px;
    line-height: 120%;
    letter-spacing: -2%;
    text-align: center;
    text-transform: capitalize;
  }

  .v-scroll-gallery-text-content__description {
    font-weight: 400;
    font-style: Normal;
    font-size: 16px;
    line-height: 140%;
    letter-spacing: -1%;
    text-align: center;
    max-width: 515px;
    margin: 0 auto;
  }


  @media screen and (max-width: 768px) {
    .v-scroll-gallery-text-content__title{
      font-size: 34px;
    }

    .v-scroll-gallery-text-content__description {
      font-size: 16px;
    }

  }


  .v-scroll-gallery{
    display: flex;
    justify-content: space-between;
    gap: 4px;
    position: relative;
    margin-top: 80px;
  }

  .v-scroll-gallery--item{
    width: 250px;
    height: 240px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border: 15px solid #E5E5E5;
  }

  .v-scroll-gallery--image{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .v-scroll-gallery-placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }



  .v-scroll-gallery--item-3{
    width: 440px;
    height: 426px;
    /*background-color: rgba(255, 0, 0, 0.5);*/
    background-color: #E5E5E5;
    z-index: 3;
  }

  .v-scroll-gallery--item-1,
  .v-scroll-gallery--item-5{
    width: 150px;
    height: 140px;
  }

  .v-scroll-gallery--item-1{
    left: 20%;
    top: 100px;
    /*background-color: rgba(0, 0, 255, 0.5);*/
    background-color: #E5E5E5;
    z-index: 1;
  }

  .v-scroll-gallery--item-5{
    left: 80%;
    top: 100px;
    /*background-color: rgba(0, 0, 255, 0.5);*/
    background-color: #E5E5E5;
    z-index: 1;
  }

  .v-scroll-gallery--item-2{
    left: 35%;
    top: 50px;
    /*background-color: rgba(0, 128, 0, 0.5);*/
    background-color: #E5E5E5;
    z-index: 2;
  }

  .v-scroll-gallery--item-4{
    left: 65%;
    top: 50px;
    /*background-color: rgba(0, 128, 0, 0.5);*/
    background-color: #E5E5E5;
    z-index: 2;
  }



  .v-scroll-gallery.final-state {
    gap: 15px;
  }

  .v-scroll-gallery.final-state .v-scroll-gallery--item {
    position: relative;
    top: 0 !important;
    left: 0 !important;
    transform: translateX(0) !important;
    width: 248px !important;
    height: 240px !important;
  }


  @media screen and (max-width: 992px) {
    .v-scroll-gallery-section {
      height: auto;
      min-height: 800px;
      padding-bottom: 40px;
    }

    .v-scroll-gallery-container {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 20px;
    }

    .v-scroll-gallery {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(248px, 1fr);
      gap: 15px;
      margin-top: 80px;
      width: max-content;
      min-width: 100%;
      position: relative;
      transform: none !important;
    }

    .v-scroll-gallery--item-1,
    .v-scroll-gallery--item-2,
    .v-scroll-gallery--item-3,
    .v-scroll-gallery--item-4,
    .v-scroll-gallery--item-5 {
      width: 248px !important;
      height: 240px !important;
      position: relative !important;
      left: 0 !important;
      top: 0 !important;
      transform: none !important;
      z-index: 1;
    }
  }


</style>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: 165px;
      padding-bottom: 30px;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.v-scroll-gallery-section');
    const gallery = document.querySelector('.v-scroll-gallery');
    const items = document.querySelectorAll('.v-scroll-gallery--item');

    if (!section) return;

    const itemStates = {
      1: { start: { left: '25%', top: '100px', width: 248, height: 240, borderWidth: 15 }, end: { left: 0, top: 0, width: 248, height: 240, borderWidth: 15 } },
      2: { start: { left: '39%', top: '30px', width: 377, height: 365, borderWidth: 20 }, end: { left: 0, top: 0, width: 248, height: 240, borderWidth: 15 } },
      3: { start: { left: '50%', top: '0px', width: 440, height: 426, borderWidth: 25 }, end: { left: 0, top: 0, width: 248, height: 240, borderWidth: 15 } },
      4: { start: { left: '61%', top: '30px', width: 377, height: 365, borderWidth: 20 }, end: { left: 0, top: 0, width: 248, height: 240, borderWidth: 15 } },
      5: { start: { left: '75%', top: '100px', width: 248, height: 240, borderWidth: 15 }, end: { left: 0, top: 0, width: 248, height: 240,borderWidth: 15 } }
    };

    function updateGalleryAnimation(progress) {

      items.forEach((item, index) => {
        const itemNumber = index + 1;
        const state = itemStates[itemNumber];

        if (state) {

          const currentLeft = progress === 1 ? state.end.left : state.start.left;
          const currentTop = progress === 1 ? state.end.top : `calc(${state.start.top} + (0px - ${state.start.top}) * ${progress})`;
          const currentWidth = state.start.width + (state.end.width - state.start.width) * progress;
          const currentHeight = state.start.height + (state.end.height - state.start.height) * progress;
          const currentBorderWidth = state.start.borderWidth + (state.end.borderWidth - state.start.borderWidth) * progress;

          item.style.left = currentLeft;
          item.style.top = currentTop;
          item.style.width = currentWidth + 'px';
          item.style.height = currentHeight + 'px';
          item.style.borderWidth = currentBorderWidth + 'px'

          if (progress === 1) {
            item.style.position = 'relative';
          } else {
            item.style.position = 'absolute';
          }
        }
      });

      if (progress === 1) {
        gallery.classList.add('final-state');
      } else {
        gallery.classList.remove('final-state');
      }
    }

    let isAnimating = false;

    function handleScroll() {
      if (isAnimating) return;

      isAnimating = true;

      const sectionRect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      const triggerPoint = windowHeight * 0.4;
      const startAnimation = triggerPoint;
      const endAnimation = windowHeight * -0.09;

      let progress = 0;

      if (sectionRect.top < startAnimation && sectionRect.bottom > endAnimation) {
        progress = 1 - (sectionRect.top - endAnimation) / (startAnimation - endAnimation);
        progress = Math.max(0, Math.min(1, progress));
      } else if (sectionRect.top <= endAnimation) {
        progress = 1;
      }

      updateGalleryAnimation(progress);

      isAnimating = false;
    }

    let scrollTimeout;

    function throttledScroll() {
      if (!scrollTimeout) {
        scrollTimeout = setTimeout(function() {
          handleScroll();
          scrollTimeout = null;
        }, 16);
      }
    }

    window.addEventListener('scroll', throttledScroll);
    window.addEventListener('resize', throttledScroll);

    updateGalleryAnimation(0);
  });
</script>

{% schema %}
{
  "name": "V-Scroll Gallery",
  "settings": [
    {
      "type": "image_picker",
      "id": "body_img",
      "label": "Body img"
    },
    {
      "type": "color",
      "id": "body_bg",
      "label": "Body Bg",
      "default": "#FAF7F1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Norkaya Is More Than Just Hydrotherapy"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Description",
      "default": "Our journey is just beginning, and we will continue to innovate. Integrating wellness concepts into every facet of your life—from the water you immerse in to the spaces you inhabit."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V-Scroll Gallery",
      "category": "Custom Sections (valmax)",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}