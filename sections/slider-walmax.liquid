<div class="scroll-gallery-section" style="background-color: {{ section.settings.color_background_card }};">

  <div class="page-width section-{{ section.id }}-padding slider__valmax">

    <div style="position: relative">
      <div class="">
        <p>{{ section.settings.heading }}</p>
        <h1 class="title">{{ section.settings.sub_heading }}</h1>
      </div>

      <div class="slider__valmax-wrapper-slide">
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <div class="slider__valmax-slide">

              <div class="slider__valmax-slide-content">

                <span>{{ forloop.index }} of {{ forloop.length }} / {{ block.settings.heading }}</span>

                <div>
                  <h2 class="title">{{ block.settings.heading }}</h2>
                  <p>{{ block.settings.sub_heading }}</p>
                </div>
              </div>

              <div class="slider__valmax-slide-img">
                <div class="slider__valmax-slide-wrapper-img">
                  {% if block.settings.image != blank %}
                    {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                    loading: 'lazy',
                    class: 'slider__valmax-img'
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="slider__valmax-slide-btn">
        <button class="prev"> {% render 'icon-arrow' %} </button>
        <button class="next"> {% render 'icon-arrow' %} </button>
      </div>
    </div>
  </div>
</div>

<style>

  .slider__valmax{
    color: #FAF7F1;
  }

  .slider__valmax .title{
    color: #FAF7F1;
  }

  .slider__valmax-wrapper-slide {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 28px;
  }

  .slider__valmax-slide-content,
  .slider__valmax-slide-img {
    width: 50%;
  }

  @media screen and (max-width: 992px) {
    .slider__valmax-slide-content,
    .slider__valmax-slide-img {
      width: 100%;
    }
  }

  .slider__valmax-slide-wrapper-img{
    height: 476px;
  }

  .slider__valmax-slide-wrapper-img svg{
    height: 476px;
    width: 100%;
  }

  .slider__valmax-img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slider__valmax-slide-img svg,
  .slider__valmax-slide-btn button svg {
    stroke: #FAF7F1;
  }

  .slider__valmax-slide-img svg {
    border: 1px solid #FAF7F1;
  }

  .slider__valmax-slide {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .slider__valmax-slide{
      flex-direction: column;
    }
  }

  .slider__valmax-slide-btn button{
    border-radius: 50%;
    width: 44px;
    height: 44px;
    background-color: transparent;
    border: 1px solid #FAF7F1;
    cursor: pointer;
  }

  .slider__valmax-slide-btn {
    position: absolute;
    bottom: 25px;
    left: 25px;
  }

  .slider__valmax-slide-btn .prev svg{
    rotate: 180deg;
  }

  .slider__valmax-wrapper-slide {
    display: flex;
    transition: transform 0.3s ease-in-out;
    width: 100%;
  }

</style>

{% style %}
  .slider__valmax-wrapper-slide{
    background-color: {{ section.settings.color_background_section }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<script>
  function initSliderValmax() {
    const slider = document.querySelector('.slider__valmax-wrapper-slide');
    const slides = document.querySelectorAll('.slider__valmax-slide');
    const prevBtn = document.querySelector('.slider__valmax-slide-btn .prev');
    const nextBtn = document.querySelector('.slider__valmax-slide-btn .next');

    let currentIndex = 0;
    let isAnimating = false;
    let touchStartX = 0;
    let touchEndX = 0;


    function addSliderStyles() {
      if (!slider) return;

      slider.style.display = 'flex';
      slider.style.transition = 'transform 0.3s ease-in-out';
      slider.style.width = '100%';


      slides.forEach((slide, index) => {
        slide.style.flex = '0 0 100%';
        slide.style.width = '100%';
        slide.style.minWidth = '100%';


        if (index !== currentIndex) {
          slide.style.opacity = '0';
          slide.style.visibility = 'hidden';
          slide.style.position = 'absolute';
        } else {
          slide.style.opacity = '1';
          slide.style.visibility = 'visible';
          slide.style.position = 'relative';
        }
      });
    }

    function updateSliderPosition() {
      if (!slider || !slides.length) return;

      slides.forEach((slide, index) => {
        if (index === currentIndex) {
          slide.style.opacity = '1';
          slide.style.visibility = 'visible';
          slide.style.position = 'relative';
          slide.style.transition = 'opacity 0.3s ease-in-out';
        } else {
          slide.style.opacity = '0';
          slide.style.visibility = 'hidden';
          slide.style.position = 'absolute';
        }
      });

      // slider.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    function goToSlide(index) {
      if (isAnimating || index < 0 || index >= slides.length) return;

      isAnimating = true;

      slides[currentIndex].style.opacity = '0';

      setTimeout(() => {
        currentIndex = index;
        updateSliderPosition();

        setTimeout(() => {
          isAnimating = false;
        }, 300);
      }, 150);
    }

    function nextSlide() {
      if (currentIndex < slides.length - 1) {
        goToSlide(currentIndex + 1);
      }
    }

    function prevSlide() {
      if (currentIndex > 0) {
        goToSlide(currentIndex - 1);
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', prevSlide);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', nextSlide);
    }

    if (slider) {
      slider.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      });

      slider.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      });
    }

    function handleSwipe() {
      if (isAnimating) return;

      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
    }

    addSliderStyles();
    updateSliderPosition();
  }

  document.addEventListener('DOMContentLoaded', initSliderValmax);
</script>

